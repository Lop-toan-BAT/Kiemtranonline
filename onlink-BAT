    // Bóc tách ngoặc nhọn lồng nhau (Stack Parser)
    function extractBracedBlocks(text, startIndex = 0) {
      let blocks = [];
      let depth = 0;
      let current = "";
      let recording = false;

      for (let i = startIndex; i < text.length; i++) {
        const c = text[i];
        const prev = i > 0 ? text[i - 1] : '';

        if (c === '{' && prev !== '\\') {
          if (depth === 0) { recording = true; current = ""; }
          else { current += c; }
          depth++;
        } else if (c === '}' && prev !== '\\') {
          depth--;
          if (depth === 0 && recording) {
            blocks.push({ content: current.trim(), endIndex: i });
            recording = false;
          } else { current += c; }
        } else if (recording) {
          current += c;
        }
      }
      return blocks;
    }

    // Chuyển đổi \begin{enumerate}[a)] sang cấu trúc HTML hợp lệ cho KaTeX
    function convertEnumerateToHtml(text) {
      return text.replace(/\\begin\{enumerate\}(?:\[(.*?)\])?([\s\S]*?)\\end\{enumerate\}/g, function(match, opt, body) {
        const isAlpha = !opt || opt.includes('a');
        const items = body.split(/\\item\s*/).filter(x => x.trim().length > 0);
        const alphaList = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
        
        let html = '<div class="my-2.5 pl-3 space-y-1.5 border-l-2 border-indigo-200">';
        items.forEach((item, idx) => {
          const prefix = isAlpha ? `${alphaList[idx] || (idx + 1)})` : `${idx + 1})`;
          html += `<div class="flex items-start gap-2 text-sm"><strong class="text-indigo-600 font-bold shrink-0">${prefix}</strong><div class="leading-relaxed text-slate-800">${item.trim()}</div></div>`;
        });
        html += '</div>';
        return html;
      });
    }

    function cleanLatexText(str) {
      return str
        .replace(/``/g, '“')
        .replace(/''/g, '”')
        .replace(/\\\\\s*$/g, '')
        .trim();
    }

   function autoFixTikzCode(code) {
      return code
        .replace(/\\begin\{center\}/g, '')
        .replace(/\\end\{center\}/g, '')
        .replace(/\\colon/g, ':')
        // Tự động bọc ngoặc nhọn cho các biểu thức tọa độ có phép tính + - * /
        .replace(/\(([0-9.\-]+)\s*,\s*([0-9.\-+*/\s]+)\)/g, function(match, x, y) {
          if (/[+\-*/]/.test(y) && !y.trim().startsWith('{')) {
            return `(${x},{${y.trim()}})`;
          }
          return match;
        })
        .trim();
    }

    // Nạp đầy đủ thư viện angles, quotes, patterns cho TikZ
   async function convertTikzToSvg(rawTikz) {
      try {
        let cleanTikz = rawTikz
          .replace(/\\begin\{center\}/g, '')
          .replace(/\\end\{center\}/g, '')
          .replace(/\\colon/g, ':')
          .replace(/shift=\(\s*\{([^}]+)\}\s*\)/g, 'shift={($1)}')
          .replace(/\(([A-Za-z0-9]+)'\)/g, '($11)')
          .replace(/angle\s*=\s*([^'}\s]+)'/g, 'angle = $11')
          .replace(/--([A-Za-z0-9]+)'/g, '--$11')
          .trim();

        // Khung tài liệu TeX đầy đủ gói
        const fullDoc = `\\documentclass[tikz,border=4pt]{standalone}
\\usepackage{amsmath,amssymb}
\\usepackage{pgfplots}
\\pgfplotsset{compat=1.18}
\\usetikzlibrary{calc,arrows.meta,intersections,angles,quotes,patterns,positioning}
\\begin{document}
${cleanTikz}
\\end{document}`;

        // Nén dữ liệu gửi sang Kroki
        const bytes = new TextEncoder().encode(fullDoc);
        const deflated = pako.deflate(bytes, { level: 9 });
        let binary = '';
        for (let i = 0; i < deflated.byteLength; i++) {
          binary += String.fromCharCode(deflated[i]);
        }
        const base64Url = btoa(binary)
          .replace(/\+/g, '-')
          .replace(/\//g, '_')
          .replace(/=+$/, '');

        const imgUrl = `https://kroki.io/tikz/svg/${base64Url}`;

        // Trả về đúng định dạng thẻ img như mẫu thầy yêu cầu
        return `<div class="my-3 w-full text-center">
                  <img src="${imgUrl}" style="max-height: 200px;" class="img-center" alt="Hình vẽ minh họa" loading="lazy">
                </div>`;
      } catch (err) {
        console.error("Lỗi dựng TikZ:", err);
        return `<div class="my-3 p-2 bg-rose-50 border border-rose-200 text-rose-700 text-xs text-center rounded">[Lỗi dựng hình TikZ]</div>`;
      }
    }
    async function parseLatexExam(rawSource) {
      // 1. Chuyển đổi môi trường enumerate trước
      let textConverted = convertEnumerateToHtml(rawSource);
      let cleaned = textConverted.replace(/(^|[^\\])%.*$/gm, '$1').replace(/\r\n/g, '\n');
      
      const parsed = [];
      const exRegex = /\\begin\{(ex|bt)\}([\s\S]*?)\\end\{\1\}/g;
      let match;

      while ((match = exRegex.exec(cleaned)) !== null) {
        let block = match[2].trim();
        let solution = "Không có lời giải chi tiết.";

        const lgIdx = block.indexOf('\\loigiai');
        if (lgIdx !== -1) {
          const lgBlocks = extractBracedBlocks(block, lgIdx);
          if (lgBlocks.length > 0) {
            solution = cleanLatexText(lgBlocks[0].content);
            block = block.substring(0, lgIdx).trim();
          }
        }

        let type = 'MC';
        let questionText = block;
        let options = [];
        let correctAnswer = null;

        const saIdx = block.indexOf('\\shortans');
        if (saIdx !== -1) {
          type = 'SA';
          questionText = block.substring(0, saIdx).trim();
          const saBlocks = extractBracedBlocks(block, saIdx);
          if (saBlocks.length > 0) correctAnswer = saBlocks[0].content.trim().replace(',', '.');
        } else if (block.includes('\\choiceTF')) {
          type = 'TF';
          const tfIdx = block.indexOf('\\choiceTF');
          questionText = block.substring(0, tfIdx).trim();
          const choicesPart = block.substring(tfIdx + 9);
          const optBlocks = extractBracedBlocks(choicesPart);
          correctAnswer = [];
          for (let i = 0; i < Math.min(optBlocks.length, 4); i++) {
            let item = optBlocks[i].content.trim();
            let isTrue = item.startsWith('\\True') || item.includes('\\True');
            item = item.replace(/\\True\s*/g, '').trim();
            options.push(cleanLatexText(item));
            correctAnswer.push(isTrue);
          }
        } else if (block.includes('\\choice')) {
          type = 'MC';
          const cIdx = block.indexOf('\\choice');
          questionText = block.substring(0, cIdx).trim();
          const choicesPart = block.substring(cIdx + 7);
          const optBlocks = extractBracedBlocks(choicesPart);
          correctAnswer = 0;
          for (let i = 0; i < Math.min(optBlocks.length, 4); i++) {
            let item = optBlocks[i].content.trim();
            if (item.startsWith('\\True') || item.includes('\\True')) {
              correctAnswer = i;
              item = item.replace(/\\True\s*/g, '').trim();
            }
            options.push(cleanLatexText(item));
          }
        }

        // Dựng hình TikZ sang SVG
        const tikzRegex = /(\\begin\{center\}\s*)?\\begin\{tikzpicture\}[\s\S]*?\\end\{tikzpicture\}(\s*\\end\{center\})?/g;
        const tikzMatches = questionText.match(tikzRegex);
        if (tikzMatches) {
          for (let tikzCode of tikzMatches) {
            const svgHtml = await convertTikzToSvg(tikzCode);
            questionText = questionText.replace(tikzCode, svgHtml);
          }
        }

        questionText = cleanLatexText(questionText);

        parsed.push({
          id: parsed.length + 1,
          type: type,
          question: questionText,
          options: options,
          answer: correctAnswer,
          solution: solution
        });
      }

      return parsed;
    }

    async function loadExamFromText(source, minutes = 45) {
      examData = await parseLatexExam(source);
      timeTotalSec = minutes * 60;
      document.getElementById('lbl-q-count').innerText = examData.length;
    }

    function renderMath(dom) {
      if (window.renderMathInElement) {
        renderMathInElement(dom || document.body, {
          delimiters: [
            { left: "$$", right: "$$", display: true },
            { left: "$", right: "$", display: false }
          ],
          throwOnError: false
        });
      }
    }

    document.getElementById('form-start').addEventListener('submit', function(e) {
      e.preventDefault();
      studentInfo.name = document.getElementById('stu-name').value.trim();
      studentInfo.class = document.getElementById('stu-class').value.trim();
      studentInfo.id = document.getElementById('stu-id').value.trim() || 'N/A';

      document.getElementById('exam-user-label').innerText = `${studentInfo.name} (${studentInfo.class})`;
      document.getElementById('screen-start').classList.add('hidden');
      document.getElementById('panel-admin').classList.add('hidden');
      document.getElementById('btn-open-admin').classList.add('hidden');
      document.getElementById('screen-exam').classList.remove('hidden');
      document.getElementById('timer-box').classList.remove('hidden');
      document.getElementById('timer-box').classList.add('flex');

      buildQuestionsUI();
      startExamTimer();
      lucide.createIcons();
    });

    function buildQuestionsUI() {
      const container = document.getElementById('questions-box');
      const palette = document.getElementById('palette-box');
      container.innerHTML = '';
      palette.innerHTML = '';

      examData.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.id = `palette-btn-${idx}`;
        btn.type = 'button';
        btn.className = 'w-full py-2 rounded-lg text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition';
        btn.innerText = idx + 1;
        btn.onclick = () => document.getElementById(`q-card-${idx}`).scrollIntoView({ behavior: 'smooth', block: 'center' });
        palette.appendChild(btn);

        const card = document.createElement('div');
        card.id = `q-card-${idx}`;
        card.className = 'bg-white p-5 rounded-2xl shadow-sm border border-slate-200';

        let bodyHtml = '';

        if (q.type === 'MC') {
          const letters = ['A', 'B', 'C', 'D'];
          let opts = '';
          q.options.forEach((opt, oIdx) => {
            opts += `
              <label class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition opt-lbl-${idx}" data-opt="${oIdx}">
                <input type="radio" name="opt-${idx}" value="${oIdx}" class="w-4 h-4 text-indigo-600 focus:ring-0" onchange="chooseMC(${idx}, ${oIdx})">
                <span class="font-bold text-slate-600 text-xs">${letters[oIdx]}.</span>
                <span class="text-sm font-medium text-slate-800">${opt}</span>
              </label>
            `;
          });
          bodyHtml = `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-3">${opts}</div>`;
        } else if (q.type === 'TF') {
          const subLetters = ['a', 'b', 'c', 'd'];
          let rows = '';
          q.options.forEach((opt, oIdx) => {
            rows += `
              <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl border border-slate-200 gap-3">
                <div class="text-sm font-medium text-slate-800">
                  <strong class="text-indigo-600 mr-1">${subLetters[oIdx]})</strong> ${opt}
                </div>
                <div class="flex items-center gap-3 shrink-0">
                  <label class="flex items-center gap-1 cursor-pointer text-xs font-semibold">
                    <input type="radio" name="tf-${idx}-${oIdx}" value="true" class="text-emerald-600 focus:ring-0" onchange="chooseTF(${idx}, ${oIdx}, true)"> Đúng
                  </label>
                  <label class="flex items-center gap-1 cursor-pointer text-xs font-semibold">
                    <input type="radio" name="tf-${idx}-${oIdx}" value="false" class="text-rose-600 focus:ring-0" onchange="chooseTF(${idx}, ${oIdx}, false)"> Sai
                  </label>
                </div>
              </div>
            `;
          });
          bodyHtml = `<div class="space-y-2 mt-3">${rows}</div>`;
        } else if (q.type === 'SA') {
          bodyHtml = `
            <div class="mt-4 flex items-center gap-3">
              <span class="text-xs font-semibold text-slate-600">Đáp án của bạn:</span>
              <input type="text" id="sa-input-${idx}" oninput="chooseSA(${idx}, this.value)" placeholder="Nhập số..." class="w-40 px-3 py-1.5 border-2 border-indigo-200 focus:border-indigo-600 rounded-lg text-sm font-bold text-indigo-900 outline-none">
            </div>
          `;
        }

        const typeLabels = { MC: 'Nhiều lựa chọn', TF: 'Đúng / Sai', SA: 'Trả lời ngắn' };

        card.innerHTML = `
          <div class="flex items-start gap-2.5 mb-2">
            <span class="bg-indigo-100 text-indigo-700 font-bold px-2 py-0.5 rounded text-xs whitespace-nowrap">Câu ${idx + 1}</span>
            <span class="bg-slate-100 text-slate-600 font-semibold px-2 py-0.5 rounded text-[11px] whitespace-nowrap">${typeLabels[q.type]}</span>
            <div class="text-sm sm:text-base font-medium text-slate-900 leading-relaxed w-full">${q.question}</div>
          </div>
          ${bodyHtml}
        `;
        container.appendChild(card);
      });

      renderMath(container);
    }

    function chooseMC(qIdx, optIdx) {
      userAnswers[qIdx] = optIdx;
      markPaletteDone(qIdx);
    }

    function chooseTF(qIdx, subIdx, val) {
      if (!userAnswers[qIdx] || typeof userAnswers[qIdx] !== 'object') userAnswers[qIdx] = {};
      userAnswers[qIdx][subIdx] = val;
      if (Object.keys(userAnswers[qIdx]).length === 4) markPaletteDone(qIdx);
    }

    function chooseSA(qIdx, val) {
      const trimmed = val.trim();
      if (trimmed) {
        userAnswers[qIdx] = trimmed;
        markPaletteDone(qIdx);
      } else {
        delete userAnswers[qIdx];
        document.getElementById(`palette-btn-${qIdx}`).className = 'w-full py-2 rounded-lg text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700';
      }
    }

    function markPaletteDone(qIdx) {
      const btn = document.getElementById(`palette-btn-${qIdx}`);
      if (btn) btn.className = 'w-full py-2 rounded-lg text-xs font-bold bg-indigo-600 text-white shadow';
      document.getElementById('exam-progress-label').innerText = `Đã làm: ${Object.keys(userAnswers).length}/${examData.length}`;
    }

    function startExamTimer() {
      const display = document.getElementById('timer-display');
      timerInterval = setInterval(() => {
        timeSpentSec++;
        let remain = timeTotalSec - timeSpentSec;
        if (remain <= 0) {
          clearInterval(timerInterval);
          alert("Hết giờ làm bài! Tự động nộp bài.");
          submitExam();
          return;
        }
        let m = Math.floor(remain / 60);
        let s = remain % 60;
        display.innerText = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
      }, 1000);
    }

    function confirmSubmit() {
      if (!confirm("Bạn có chắc chắn muốn nộp bài thi?")) return;
      submitExam();
    }

    function submitExam() {
      clearInterval(timerInterval);
      let totalScore = 0;

      examData.forEach((q, idx) => {
        const uAns = userAnswers[idx];
        if (q.type === 'MC') {
          if (uAns === q.answer) totalScore += 0.25;
        } else if (q.type === 'TF') {
          if (uAns && typeof uAns === 'object') {
            let correctSubs = 0;
            for (let i = 0; i < 4; i++) {
              if (uAns[i] === q.answer[i]) correctSubs++;
            }
            if (correctSubs === 1) totalScore += 0.1;
            else if (correctSubs === 2) totalScore += 0.25;
            else if (correctSubs === 3) totalScore += 0.5;
            else if (correctSubs === 4) totalScore += 1.0;
          }
        } else if (q.type === 'SA') {
          if (uAns && String(uAns).replace(',', '.') === String(q.answer).replace(',', '.')) {
            totalScore += 0.5;
          }
        }
      });

      const finalScore = totalScore.toFixed(2);

      document.getElementById('screen-exam').classList.add('hidden');
      document.getElementById('timer-box').classList.add('hidden');
      document.getElementById('screen-result').classList.remove('hidden');

      document.getElementById('res-user-info').innerText = `${studentInfo.name} - Lớp ${studentInfo.class}`;
      document.getElementById('res-score').innerText = finalScore;

      let m = Math.floor(timeSpentSec / 60);
      let s = timeSpentSec % 60;
      document.getElementById('res-time').innerText = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;

      renderSolutions();
      lucide.createIcons();

      sendScoreToGoogleSheet({
        name: studentInfo.name,
        className: studentInfo.class,
        id: studentInfo.id,
        score: finalScore,
        correctCount: 'Đa phần',
        totalQuestions: examData.length,
        timeSpentSec: timeSpentSec,
        answers: JSON.stringify(userAnswers)
      });
    }

    function sendScoreToGoogleSheet(data) {
      if (!GOOGLE_SCRIPT_URL || !GOOGLE_SCRIPT_URL.startsWith('http')) return;
      const iframeName = 'hidden_iframe_submit';
      let iframe = document.getElementById(iframeName);
      if (!iframe) {
        iframe = document.createElement('iframe');
        iframe.id = iframeName;
        iframe.name = iframeName;
        iframe.style.display = 'none';
        document.body.appendChild(iframe);
      }

      const form = document.createElement('form');
      form.method = 'POST';
      form.action = GOOGLE_SCRIPT_URL;
      form.target = iframeName;

      for (const k in data) {
        const inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = k;
        inp.value = data[k];
        form.appendChild(inp);
      }

      document.body.appendChild(form);
      form.submit();
      setTimeout(() => document.body.removeChild(form), 1000);
    }

    function renderSolutions() {
      const container = document.getElementById('solutions-box');
      container.innerHTML = '';
      const letters = ['A', 'B', 'C', 'D'];
      const subLetters = ['a', 'b', 'c', 'd'];

      examData.forEach((q, idx) => {
        const uAns = userAnswers[idx];
        let detailHtml = '';

        if (q.type === 'MC') {
          const isCorrect = uAns === q.answer;
          detailHtml = `
            <p>• Bạn chọn: <strong class="${isCorrect ? 'text-emerald-600' : 'text-rose-600'}">${uAns !== undefined ? letters[uAns] : 'Chưa chọn'}</strong></p>
            <p>• Đáp án đúng: <strong class="text-emerald-700">${letters[q.answer]}</strong></p>
          `;
        } else if (q.type === 'TF') {
          let list = '';
          for (let i = 0; i < 4; i++) {
            const userVal = uAns ? uAns[i] : undefined;
            const trueVal = q.answer[i];
            const ok = userVal === trueVal;
            list += `<div>Ý ${subLetters[i]}: Bạn chọn <strong>${userVal === true ? 'Đúng' : userVal === false ? 'Sai' : 'Chưa chọn'}</strong> | Đáp án: <strong class="${ok ? 'text-emerald-600' : 'text-rose-600'}">${trueVal ? 'Đúng' : 'Sai'}</strong></div>`;
          }
          detailHtml = `<div class="space-y-1 text-xs">${list}</div>`;
        } else if (q.type === 'SA') {
          const isCorrect = uAns && String(uAns).replace(',', '.') === String(q.answer).replace(',', '.');
          detailHtml = `
            <p>• Bạn trả lời: <strong class="${isCorrect ? 'text-emerald-600' : 'text-rose-600'}">${uAns || 'Chưa trả lời'}</strong></p>
            <p>• Đáp số đúng: <strong class="text-emerald-700 font-bold">${q.answer}</strong></p>
          `;
        }

        const row = document.createElement('div');
        row.className = 'pt-4 first:pt-0';
        row.innerHTML = `
          <div class="flex items-start gap-2 mb-2">
            <span class="bg-indigo-100 text-indigo-700 font-bold px-2 py-0.5 rounded text-xs">Câu ${idx + 1}</span>
            <div class="text-sm font-medium text-slate-800 w-full">${q.question}</div>
          </div>
          <div class="text-xs space-y-1 mb-2 text-slate-600 bg-slate-50 p-2.5 rounded-lg border border-slate-100">${detailHtml}</div>
          <div class="bg-indigo-50/50 p-3 rounded-lg border border-indigo-100 text-xs text-slate-700 leading-relaxed">
            <strong class="text-indigo-800">Lời giải chi tiết:</strong><br>${q.solution}
          </div>
        `;
        container.appendChild(row);
      });

      renderMath(container);
    }

    // KHỞI ĐỘNG HỆ THỐNG
    window.onload = async function() {
      const urlParams = new URLSearchParams(window.location.search);
      const pasteId = urlParams.get('id');

      if (pasteId) {
        document.getElementById('panel-admin').classList.add('hidden');
        document.getElementById('btn-open-admin').classList.add('hidden');

        const sLoader = document.getElementById('student-loading');
        sLoader.classList.remove('hidden');

        try {
          const res = await fetch(`https://dpaste.com/${pasteId}.txt`);
          if (res.ok) {
            const rawContent = await res.text();
            const data = JSON.parse(rawContent);
            await loadExamFromText(data.tex, data.t);
          } else {
            alert("Không tìm thấy đề thi này hoặc đề đã quá hạn!");
          }
        } catch (e) {
          alert("Lỗi tải đề thi, vui lòng thử lại!");
        } finally {
          sLoader.classList.add('hidden');
        }
      } else {
        document.getElementById('latex-code').value = DEFAULT_LATEX_SOURCE;
        await loadExamFromText(DEFAULT_LATEX_SOURCE, 45);
      }

      lucide.createIcons();
    };
  </script>
